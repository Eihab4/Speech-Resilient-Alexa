MCP_NAME=speech-resilient-alexa
MCP_TRANSPORT=streamable-http
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PATH=/mcp
MCP_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

LLM_PROVIDER=openrouter
LLM_MAX_TOKENS=300
LLM_TEMPERATURE=0

MEMORY_DB_PATH=data/memory.db
MEMORY_COMPANY_ID=demo
MEMORY_UNFINISHED_TTL_HOURS=24
MEMORY_RECENT_MESSAGES=10
MEMORY_SUMMARY_TRIGGER_WORDS=400

OPENROUTER_API_KEY=
OPENROUTER_MODEL_ID=google/gemini-3.1-flash-lite
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_APP_TITLE="Speech-Resilient Alexa"

AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
