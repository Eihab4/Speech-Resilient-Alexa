MCP_NAME=speech-resilient-alexa
MCP_TRANSPORT=streamable-http
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PATH=/mcp
# Extra browser pages allowed to call the server. Localhost on any port is always allowed.
MCP_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

LLM_PROVIDER=openrouter
LLM_MAX_TOKENS=300
LLM_TEMPERATURE=0

MEMORY_DB_PATH=data/memory.db
MEMORY_COMPANY_ID=demo
MEMORY_UNFINISHED_TTL_HOURS=24
MEMORY_RECENT_MESSAGES=10
MEMORY_SUMMARY_TRIGGER_WORDS=400

# How long a sign-in lasts before the person must sign in again.
SESSION_TTL_HOURS=720

# After this many questions about one request, Alexa switches to yes/no guesses.
YES_NO_AFTER_TRIES=3

# After this many questions about one request, Alexa sends the helper what she understood so far.
HELP_AFTER_TRIES=5

# How many days speech_trend looks back.
TREND_DAYS=14

# Emergency alerts: how long Alexa waits for "stop", and how soon the same alert can be sent again.
SOS_COUNTDOWN_SECONDS=5
SOS_COOLDOWN_MINUTES=2

# How long Alexa waits for each person before answering: learned from their own pauses, within these limits.
PAUSE_START_SECONDS=2
PAUSE_MIN_SECONDS=1.5
PAUSE_MAX_SECONDS=6
PAUSE_STEP_SECONDS=0.5
PAUSE_IGNORE_OVER_SECONDS=10
PAUSE_KEEP=20
PAUSE_MIN_SAMPLES=5
PAUSE_MARGIN=1.2

# Telegram bot that delivers emergency alerts to helpers. Empty: alerts are only written to the server log.
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_URL=https://api.telegram.org
TELEGRAM_POLL_SECONDS=25
TELEGRAM_TIMEOUT_SECONDS=10

# Amazon Location turns an alert's coordinates into an address (uses the AWS credentials and AWS_REGION).
LOCATION_ENABLED=true
LOCATION_LANGUAGE=en
LOCATION_TIMEOUT_SECONDS=2

OPENROUTER_API_KEY=
OPENROUTER_MODEL_ID=google/gemini-3.1-flash-lite
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_APP_TITLE="Speech-Resilient Alexa"

GROQ_API_KEY=
GROQ_MODEL_ID=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_TIMEOUT_SECONDS=30
GROQ_REASONING_EFFORT=low

# Voice input through Amazon Transcribe (uses the AWS credentials and AWS_REGION).
TRANSCRIBE_PATH=/transcribe
TRANSCRIBE_LANGUAGE_CODE=en-US
TRANSCRIBE_SAMPLE_RATE_HZ=16000

# Voice output through Amazon Polly (uses the AWS credentials and AWS_REGION).
POLLY_PATH=/speak
POLLY_VOICE_ID=Joanna
POLLY_ENGINE=neural
POLLY_OUTPUT_FORMAT=mp3

AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
