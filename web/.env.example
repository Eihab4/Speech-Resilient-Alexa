# Port for the dev page. Any localhost port works: the server always allows localhost.
WEB_PORT=5180

# During local development, API and WebSocket requests use the Vite proxy to port 8000.
# Set VITE_MCP_URL only when the MCP server is hosted on a different origin.
# VITE_MCP_URL=http://127.0.0.1:8000/mcp
# VITE_MCP_PROXY_TARGET=http://127.0.0.1:8000

# The voice WebSocket. By default it sits next to /mcp, at /transcribe.
# VITE_TRANSCRIBE_URL=ws://127.0.0.1:8000/transcribe

# Language the microphone listens for.
VITE_SPEECH_LANG=en-US
